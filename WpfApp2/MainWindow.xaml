<Window x:Class="MazePhysicsGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Лабиринт Физики"
        Background="#111318"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid>
            <Canvas x:Name="GameCanvas"
                    Background="#1b1f27"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    SizeChanged="GameCanvas_SizeChanged"/>
        </Grid>

        <!-- HUD справа, полупрозрачный, поверх поля -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#cc111318" BorderBrush="#8fe3ff" BorderThickness="0,0,0,2"
                Padding="16,12" Width="300">
            <StackPanel>
                <TextBlock Text="Лабиринт Физики" FontSize="20" FontWeight="Bold" Foreground="#8fe3ff"/>
                <TextBlock x:Name="ScoreText"  Text="Счёт: 0"             Foreground="White" FontSize="16" Margin="0,10,0,0"/>
                <TextBlock x:Name="CoinsText"  Text="Монет собрано: 0"    Foreground="White" FontSize="16"/>
                <TextBlock x:Name="SpeedText"  Text="Ускорение: x1.0"     Foreground="#ffd479" FontSize="16"/>
                <TextBlock x:Name="CaughtText" Text="Поймано: 0 / 5"      Foreground="#9effa1" FontSize="16"/>
                <TextBlock x:Name="TimerText"  Text="До респавна: 60 c"   Foreground="#ff8888" FontSize="18"
                           FontWeight="Bold" Margin="0,8,0,0"/>
                <TextBlock x:Name="StatusText" Text="Соберите монеты и поймайте 5 противников!"
                           Foreground="#9effa1" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="Управление: стрелки или WASD"
                           Foreground="#a0a0a0" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="Пробел — пауза, R — заново, Esc — выход"
                           Foreground="#a0a0a0" TextWrapping="Wrap"/>
                <TextBlock Text="Цель: догнать и коснуться врага, чтобы поймать его"
                           Foreground="#ffd479" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Button x:Name="RestartBtn" Content="Заново" Margin="0,16,0,0"
                        Padding="8" Click="Restart_Click"/>
            </StackPanel>
        </Border>

        <!-- Оверлей викторины -->
        <Grid x:Name="QuizOverlay" Background="#cc000000" Visibility="Collapsed">
            <Border Background="#1e2230" CornerRadius="12" Padding="24" MaxWidth="700"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#8fe3ff" BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="QuizTitle" Text="Вопрос по физике" FontSize="20"
                               FontWeight="Bold" Foreground="#8fe3ff" Margin="0,0,0,12"/>
                    <TextBlock x:Name="QuizQuestionText" Text="" Foreground="White" FontSize="15"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <ItemsControl x:Name="QuizOptions"/>
                    <TextBlock x:Name="QuizFeedback" Foreground="#ffd479" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Оверлей лаборатории -->
        <Grid x:Name="LabOverlay" Background="#cc000000" Visibility="Collapsed">
            <Border Background="#1e2230" CornerRadius="12" Padding="24" MaxWidth="700"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#ffa94d" BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="LabTitle" FontSize="20" FontWeight="Bold"
                               Foreground="#ffa94d" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LabDescription" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <DockPanel Margin="0,4,0,0">
                        <TextBlock Text="Напряжение (В):" DockPanel.Dock="Left" Foreground="#cfd3dc" Width="160"/>
                        <TextBlock x:Name="VoltageValueText" Text="0" DockPanel.Dock="Right"
                                   Foreground="#ffd479" FontWeight="Bold" Width="60" TextAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="VoltageSlider" Minimum="0" Maximum="50" Value="0"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="VoltageSlider_ValueChanged"/>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Сопротивление (Ом):" DockPanel.Dock="Left" Foreground="#cfd3dc" Width="160"/>
                        <TextBlock x:Name="ResistanceValueText" Text="0" DockPanel.Dock="Right"
                                   Foreground="#ffd479" FontWeight="Bold" Width="60" TextAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="ResistanceSlider" Minimum="0" Maximum="50" Value="0"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="ResistanceSlider_ValueChanged"/>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="Частота (Гц):" DockPanel.Dock="Left" Foreground="#cfd3dc" Width="160"/>
                        <TextBlock x:Name="FrequencyValueText" Text="0" DockPanel.Dock="Right"
                                   Foreground="#ffd479" FontWeight="Bold" Width="60" TextAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="FrequencySlider" Minimum="0" Maximum="200" Value="0"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="FrequencySlider_ValueChanged"/>

                    <CheckBox x:Name="CircuitClosed" Content="Цепь замкнута"
                              Foreground="White" Margin="0,12,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Проверить" Padding="16,6" Click="LabCheck_Click"/>
                        <Button Content="Отмена" Padding="16,6" Margin="12,0,0,0" Click="LabCancel_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="LabFeedback" Foreground="#ffd479" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Оверлей ловушки -->
        <Grid x:Name="TrapOverlay" Background="#cc000000" Visibility="Collapsed">
            <Border Background="#2a1010" CornerRadius="12" Padding="24" MaxWidth="700"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#ff4040" BorderThickness="2">
                <StackPanel>
                    <TextBlock x:Name="TrapTitle" FontSize="20" FontWeight="Bold"
                               Foreground="#ff6060" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TrapDescription" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <DockPanel>
                        <TextBlock Text="Выставьте напряжение (В):" DockPanel.Dock="Left" Foreground="#cfd3dc" Width="220"/>
                        <TextBlock x:Name="TrapVoltageValueText" Text="0" DockPanel.Dock="Right"
                                   Foreground="#ffd479" FontWeight="Bold" Width="60" TextAlignment="Right"/>
                    </DockPanel>
                    <Slider x:Name="TrapVoltageSlider" Minimum="0" Maximum="50" Value="0"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="TrapVoltageSlider_ValueChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Подать напряжение" Padding="16,6" Click="TrapCheck_Click"/>
                        <Button Content="Убежать" Padding="16,6" Margin="12,0,0,0" Click="TrapCancel_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TrapFeedback" Foreground="#ffd479" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>